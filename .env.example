# =============================================================================
# Panel .env Configuration
#
# These DASS_* env vars are read by the dass-desktop container's entrypoint
# and override the corresponding keys in /app/conf/system.ini at startup.
#
# Naming rule: DASS_<key with __ instead of .>
#   DASS_mysql__datasource__password  →  mysql.datasource.password
#   DASS_settings__workstationId      →  settings.workstationId
#   DASS_rabbit__host                 →  rabbit.host
#
# To update any value: edit this file then run:
#   cd /opt/meta-panel && docker compose up -d
# =============================================================================

# --- Panel-Specific (UNIQUE per panel) ---
DASS_settings__workstationId=441243
DASS_settings__panelId=441243
DASS_customerName=norma

# --- MySQL ---
DASS_mysql__datasource__jdbcUrl=jdbc:mysql://localhost:3306/dass_norma?useUnicode=yes&characterEncoding=UTF-8&useJDBCCompliantTimezoneShift=true&useLegacyDatetimeCode=false&serverTimezone=UTC&autoReconnect=true&useSSL=false&allowPublicKeyRetrieval=true
DASS_mysql__datasource__username=root
DASS_mysql__datasource__password=changeme

# --- RabbitMQ ---
DASS_rabbit__host=localhost
DASS_rabbit__port=5672
DASS_rabbit__username=dass
DASS_rabbit__password=changeme

# --- MSF API host ---
DASS_host=http://localhost:7189/
