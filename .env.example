# =============================================================================
# Panel Configuration — Copy to .env and fill in your values
#
# A default system.ini ships inside the Docker image. The values below override
# only the parts that change per panel/client. You can update any field later
# and apply with:  cd /opt/meta-panel && docker compose up -d
# =============================================================================

# --- Panel-Specific (UNIQUE per panel — REQUIRED) ---
WORKSTATION_ID=441243
PANEL_ID=441243
CUSTOMER_NAME=norma

# --- MySQL (full set — easy to update later) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=dass_norma
MYSQL_USER=root
MYSQL_PASSWORD=changeme

# --- RabbitMQ (defaults same across all clients) ---
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=dass
RABBIT_PASSWORD=dass

# --- Kafka (optional — leave empty if not used) ---
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_TOPIC=panel-events
KAFKA_USER=
KAFKA_PASSWORD=

# --- MSF API host (default: localhost via tunnel) ---
MSF_HOST=localhost

# --- Updates ---
AUTO_UPDATE=true
JAR_VERSION=latest
JAR_REPO=nuriozalp/download
