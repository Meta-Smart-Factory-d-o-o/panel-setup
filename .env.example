# =============================================================================
# Panel Configuration — Copy to .env and fill in your values
#
# Note: A default system.ini ships inside the Docker image. You only need to
# override the values that actually change per panel/client (mainly MySQL).
# Everything else (RabbitMQ user/password, theme, pool sizes, etc.) is the same
# across all clients and is set by defaults inside the image.
# =============================================================================

# --- Panel-Specific (UNIQUE per panel — REQUIRED) ---
WORKSTATION_ID=441243
PANEL_ID=441243
CUSTOMER_NAME=norma

# --- MySQL (changes per client — REQUIRED) ---
MYSQL_DB=dass_norma
MYSQL_USER=root
MYSQL_PASSWORD=changeme

# --- RabbitMQ (OPTIONAL — default user/password is 'dass/dass') ---
# Uncomment only if your client uses different RabbitMQ credentials:
# RABBIT_USER=dass
# RABBIT_PASSWORD=dass

# --- Kafka (OPTIONAL — leave empty if Kafka is not used) ---
# KAFKA_HOST=kafka.example.com
# KAFKA_PORT=9092
# KAFKA_TOPIC=panel-events
# KAFKA_USER=
# KAFKA_PASSWORD=

# --- Connection hosts (default: localhost — tunnels handle routing) ---
# MSF_HOST=localhost
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# --- Update Settings ---
AUTO_UPDATE=true
JAR_VERSION=latest
JAR_REPO=nuriozalp/download
