# =============================================================================
# Panel Configuration — Copy to .env and fill in your values
# =============================================================================

# --- Panel-Specific (UNIQUE per panel) ---
WORKSTATION_ID=441243
PANEL_ID=441243

# --- Client-Specific ---
CUSTOMER_NAME=norma

# MySQL
MYSQL_DB=norma_db
MYSQL_USER=root
MYSQL_PASSWORD=changeme

# RabbitMQ
RABBIT_USER=dass
RABBIT_PASSWORD=changeme

# Kafka (TODO: confirm exact variable names with developer)
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_TOPIC=panel-events
KAFKA_USER=
KAFKA_PASSWORD=

# --- Connection (always localhost — tunnels handle routing) ---
MSF_HOST=localhost
MYSQL_HOST=localhost
MYSQL_PORT=3306
RABBIT_HOST=localhost
RABBIT_PORT=5672

# --- Update Settings ---
AUTO_UPDATE=true
JAR_VERSION=latest
JAR_REPO=nuriozalp/download
